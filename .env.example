# Copy this file to .env, fill it in, then restart `npm run dev`.

# Firebase web app config (Firebase Console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google OAuth Web Client ID (see README). Empty = Continue with Google is hidden.
VITE_GOOGLE_CLIENT_ID=

# Paystack public key, pk_test_... for testing or pk_live_... for real money. Empty = online payment is hidden.
VITE_PAYSTACK_PUBLIC_KEY=

# Comma-separated emails that become Admin when they sign up.
VITE_ADMIN_EMAILS=
